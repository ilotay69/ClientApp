# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never exposed to the browser. Used by the
# reminder cron route to read across all rows and log sends.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) API key, used to send reminder emails.
RESEND_API_KEY=
# The "from" address reminder emails are sent as. Must be a verified domain/sender in Resend.
REMINDERS_FROM_EMAIL="CG Client Tracker <reminders@yourdomain.com>"

# Shared secret the Railway cron job must send as a header (X-Cron-Secret) to
# call /api/reminders. Generate any random string.
CRON_SECRET=

# Public URL of the deployed app, used to build links inside reminder emails.
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# Microsoft 365 / Azure AD app registration (Microsoft Entra admin center).
# Used for both "Sign in with Microsoft" and the mailbox-sync feature.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# The shared mailbox (e.g. ops@cgtechnologies.com) this app sends all its
# outbound email through — interview invites, candidate messages, task
# assignment notices, portal password resets, sales-request notifications,
# the daily reminders digest — and receives candidate replies at. Uses
# app-only Graph auth (the same AZURE_CLIENT_ID/SECRET/TENANT_ID above, with
# Application permissions Mail.Send + Mail.ReadWrite added and admin-
# consented, restricted to just this mailbox via an Exchange Application
# Access Policy) rather than a per-user login — see Settings → Integrations
# → Shared Mailbox.
SHARED_MAILBOX_EMAIL=

# Web Push (browser/PWA notifications) — a VAPID key pair identifies this
# app to push services (Chrome/FCM, Firefox, Apple's web push relay). One
# pair for the whole app, not per-mailbox. Generate with:
#   openssl ecparam -genkey -name prime256v1 -noout | openssl ec -outform DER | ...
# (or ask Claude — it generated this project's own pair without needing any
# new npm dependency). NEXT_PUBLIC_VAPID_PUBLIC_KEY must exactly match
# VAPID_PUBLIC_KEY — the client needs the public half to subscribe, the
# server needs both halves to sign and encrypt each push.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services may use if they need to reach the app owner
# about this key (e.g. abuse reports) — any mailto: works.
VAPID_SUBJECT=mailto:ops@cgtechnologies.com

# Anthropic API key (console.anthropic.com), used to generate the dashboard's
# AI insights from synced emails. Leave blank to skip that feature entirely.
ANTHROPIC_API_KEY=
# Optional — override the model used for insight generation.
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
